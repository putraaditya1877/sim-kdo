{
  "info": {
    "name": "SIM-KDO API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@simkdo.test\",\n  \"password\": \"password\"\n}" },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/dashboard"
      }
    },
    {
      "name": "Daftar kendaraan",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/kendaraan?page=1&page_size=10"
      }
    },
    {
      "name": "Tambah kendaraan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"nomor_polisi\": \"B 9999 KDO\",\n  \"merk\": \"Toyota\",\n  \"tipe\": \"Avanza\",\n  \"kondisi\": \"baik\",\n  \"tahun_produksi\": 2024,\n  \"perangkat_daerah_id\": 1\n}" },
        "url": "{{base_url}}/kendaraan"
      }
    }
  ]
}
